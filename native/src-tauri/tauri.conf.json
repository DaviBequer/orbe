{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbe",
  "version": "1.0.0",
  "identifier": "io.github.davibequer.orbe",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Orbe",
    "shortDescription": "Tarefas, agenda e diário das áreas da vida",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
